# ------------------------------------------------------------------------------
# Stock in Ounces - Automated Daily Update Configuration Template
# Rename this file to '.env' and fill in your values.
# DO NOT commit the '.env' file to Git! It is automatically ignored.
# ------------------------------------------------------------------------------

# [Python Configuration]
# Path to your python executable. If python is in your system PATH, leave as 'python'.
# If you are using a virtual environment (venv), point to its executable, e.g.:
# /home/username/Stock-In-Ounces/.venv/bin/python
PYTHON_PATH=python

# [Git Committer Configuration]
# Custom committer identity for the automated commits.
# If left blank, Git will use the system's global config settings.
GIT_USER_NAME=Data Updater Bot
GIT_USER_EMAIL=bot@stockinounces.local

# [GitHub Authentication - Choose ONE method below]

# METHOD 1: HTTPS Personal Access Token (PAT)
# 1. Create a Classic PAT or Fine-grained PAT with Repository contents 'Read & Write' access.
# 2. Paste the token below.
# Example: GITHUB_PAT=github_pat_11A...
GITHUB_PAT=

# METHOD 2: SSH Key
# 1. Ensure your SSH public key is added to your GitHub account.
# 2. Provide the absolute path to your private key file.
# Example: SSH_KEY_PATH=/home/username/.ssh/id_rsa
SSH_KEY_PATH=

